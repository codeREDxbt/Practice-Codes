import csv

# Data to be written to the CSV file
data = [
    ["Name", "Age", "City"],
    ["Alice", 25, "New Delhi"],
    ["Bob", 30, "Mumbai"],
    ["Charlie", 22, "Kolkata"]
]

# Writing to a CSV file
with open('people.csv', 'w', newline='') as file:
    writer = csv.writer(file)
    writer.writerows(data)

print("CSV file 'people.csv' created successfully.")
